# ===== Lingkungan & cache (JANGAN dikirim — dibuat ulang di tiap laptop) =====
.venv/
__pycache__/
*.pyc

# pytest test DB (dibuat baru tiap run, isolated dari umar_crm.db produksi)
tests/.test_db.sqlite*
.pytest_cache/

# ===== Basis data & sesi runtime (data lokal, dibuat otomatis saat dijalankan) =====
# Pattern `umar_crm.db*` mencakup DB utama, shm/wal, dan backup snapshot
# (umar_crm.db.before-migration-*, umar_crm.db.before-backfill-*, dst).
umar_crm.db*
neonize_auth.sqlite3
baileys_auth_info/

# ===== File unggahan (berisi PII jamaah — jangan disebar) =====
uploads_private/
public/branding/

# ===== Arsip/cadangan lama =====
*.zip
.backup/

# ===== Variabel rahasia =====
.env
# JWT signing key: auto-generated per-install (auth.py:_load_or_create_secret).
# Bocornya file ini = attacker bisa forge token siapapun. WAJIB gitignored.
.jwt_secret
# Supabase URL + key untuk sync layer (supabase_client.py). Format:
# {"url": "https://xxx.supabase.co", "key": "eyJhbGc..."}
# Bocornya file ini = attacker bisa read/write Supabase closings (PII 339 jamaah).
.supabase_config.json
# Litestream config berisi Cloudflare R2 Access Key + Secret untuk backup DB.
# Bocornya file ini = attacker bisa read/write/delete backup snapshot di R2.
litestream.yml
tools/litestream.zip
tools/litestream.exe
tools/LICENSE
tools/README.md
tools/etc/
logs/
.umar_crm.db-litestream/
migrations/__pycache__/
